<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Farmacia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#176B60</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#173A34</item>
    </style>
    <style name="CatalogoInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#173A34</item>
        <item name="android:textColorHint">#52665F</item>
    </style>
</resources>
