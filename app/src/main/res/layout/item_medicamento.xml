<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/catalogo_item_background"
    android:minHeight="80dp">
    <TextView android:id="@+id/nombreText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:textSize="16sp" android:textColor="#173A34" />
    <TextView android:id="@+id/detalleText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#435953" />
    <TextView android:id="@+id/stockText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textStyle="bold" android:textColor="#176B60" />
</LinearLayout>
