<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/catalogo_item_background"
    android:minHeight="80dp"
    android:orientation="vertical"
    android:padding="16dp"
    tools:showIn="@layout/activity_catalogo">

    <TextView
        android:id="@+id/nombreText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#173A34"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="MED-01 · Paracetamol" />

    <TextView
        android:id="@+id/detalleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#435953"
        tools:text="Analgésico · Tabletas 500 mg" />

    <TextView
        android:id="@+id/stockText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#176B60"
        android:textStyle="bold"
        tools:text="Existencia: 48 piezas" />

</LinearLayout>
